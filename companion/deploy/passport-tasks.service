[Unit]
Description=AI Passport cached task API
After=network.target

[Service]
Type=simple
User=passport-tasks
Group=passport-tasks
WorkingDirectory=/opt/passport-tasks
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/passport-tasks/vendor
Environment=SUITE_TASKS_CONFIG=/etc/passport-tasks/config.json
Environment=SUITE_TASKS_DATABASE=/var/lib/passport-tasks/tasks.sqlite3
ExecStart=/usr/bin/python3 -m gunicorn --config companion/deploy/gunicorn.conf.py "companion.tasks.wsgi:create_app()"
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=passport-tasks
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/passport-tasks
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
TasksMax=16

[Install]
WantedBy=multi-user.target
